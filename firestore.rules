rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["alexandre.ranson@gmail.com", "doug.benchetrit@gmail.com"];
    }

    // Utilisateurs — lecture publique, écriture uniquement par soi-même
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      // TEMPORAIRE: Permettre création d'utilisateurs test
      allow create: if request.auth != null && userId.matches('testuser.*');
    }

    // Objets — lecture publique (feed accessible sans compte), écriture uniquement par le propriétaire
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
         || request.auth.uid == resource.data.userId
         || request.auth.uid == resource.data.uid);
    }

    // Échanges — lecture pour les participants et les admins, écriture pour les participants
    match /exchanges/{exchangeId} {
      allow read: if isAdmin() || (request.auth != null
        && (request.auth.uid in resource.data.participants
            || request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId));
      allow write: if request.auth != null
        && (request.auth.uid in resource.data.participants
            || request.auth.uid == resource.data.senderId
            || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null;

      // Sous-collection messages — accessible uniquement aux participants de l'échange
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/exchanges/$(exchangeId)).data.participants;
      }
    }

    // Avis — lecture publique, écriture uniquement par l'auteur
    match /reviews/{reviewId} {
      allow read: if request.auth != null && resource.data.isVisible == true;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 
        && request.resource.data.rating <= 5;
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.fromUserId;
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.fromUserId;
    }

    // Feedback post-troc — lecture connectée, écriture par un participant de l'échange
    match /feedback/{feedbackId} {
      allow read: if isAdmin()
        || (request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/exchanges/$(resource.data.exchangeId)).data.participants);
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.exchangeId is string
        && request.auth.uid in get(/databases/$(database)/documents/exchanges/$(request.resource.data.exchangeId)).data.participants;
      allow delete: if false;
    }

  }
}
